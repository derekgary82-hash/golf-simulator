# Copy this file to the project root as 'keystore.properties' (do NOT commit the real file).
# Example values:
# storeFile=/full/path/to/keystore.jks
# storePassword=your_store_password
# keyAlias=your_key_alias
# keyPassword=your_key_password

# NOTE: Keystore files and passwords are secrets. Add keystore.properties to .gitignore and/or use GitHub Secrets.
